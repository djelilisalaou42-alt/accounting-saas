# =====================================================================
# Variables d'environnement — docker-compose.prod.yml
#
# Copier ce fichier vers .env.production PUIS renseigner de vraies
# valeurs. JAMAIS de secret réel dans ce fichier .example, jamais
# .env.production dans Git (déjà exclu, voir .gitignore).
#
# Usage :
#   cp .env.production.example .env.production
#   # éditer .env.production avec de vraies valeurs
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =====================================================================

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=accounting_prod
POSTGRES_PASSWORD=change_me_generate_a_strong_random_password
POSTGRES_DB=accounting_saas

# --- JWT — CRITIQUE : générer avec, par exemple, `openssl rand -base64 48` ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Domaines réels (jamais localhost en production) --------------------
CORS_ORIGIN=https://votre-domaine.example
FRONTEND_URL=https://votre-domaine.example
# URL publique de l'API telle qu'accessible depuis le navigateur des
# utilisateurs (via le reverse proxy, voir deploy/nginx.conf.example) —
# INLINÉE AU BUILD du frontend, voir frontend/Dockerfile.
NEXT_PUBLIC_API_URL=https://votre-domaine.example/api/v1

# --- Pièces jointes ------------------------------------------------------
ATTACHMENTS_MAX_SIZE_BYTES=10485760

# --- Sécurité --------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Données de démonstration --------------------------------------------
# JAMAIS "true" pour une vraie production — uniquement pour un
# environnement de démonstration explicitement voulu (crée un compte
# admin@demo.local / Demo1234! avec des identifiants publiquement
# connus, voir README).
SEED_DEMO_DATA=false
