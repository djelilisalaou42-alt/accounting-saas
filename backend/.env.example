# Base de données
DATABASE_URL="postgresql://accounting_user:accounting_password@localhost:5432/accounting_saas?schema=public"
# Base dédiée aux tests (jamais la même que DATABASE_URL) — voir .env.test
DATABASE_URL_TEST="postgresql://accounting_user:accounting_password@localhost:5432/accounting_saas_test?schema=public"

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# JWT
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Sécurité
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
CORS_ORIGIN="http://localhost:3000"

# URL publique du frontend — utilisée pour construire les liens envoyés
# par email (invitation à rejoindre une entreprise, réinitialisation de
# mot de passe). Sans cette variable, le code retombe silencieusement
# sur http://localhost:3000, ce qui produirait des liens cassés dans de
# vrais emails envoyés en production — DOIT être définie explicitement.
FRONTEND_URL="http://localhost:3000"

# Pièces jointes (Étape 16)
ATTACHMENTS_STORAGE_PATH="./storage/attachments"
ATTACHMENTS_MAX_SIZE_BYTES=10485760
